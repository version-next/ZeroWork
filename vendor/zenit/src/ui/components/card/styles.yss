//! Card styles: appearance = variant (default / outlined / elevated / floating) x selected x
//! hover-responsive;
//! all values reference tokens.
//! View in card.yix; CardVariant is public API defined in mod.zig.
const ui = @import("../../ui.zig");

/// Card root: when selected, 1px accent-border and no hover highlight; hover highlight changes
/// border color for outlined, background for others.
/// Background and border color changes via 120ms transition.
recipe Card {
  base {
    direction: column;
    background: bg-primary;
    corner-radius: panel;
    transition: background 120ms ease-out, border-color 120ms ease-out;
  }
  variant kind = default {
    default  { background: bg-secondary; border-overlay: true; border: 1 transparent; }
    outlined { border-overlay: true; border: 1 border; }
    elevated { border-overlay: true; border: 1 border; }
    /// A non-modal floating panel (a card floating over the window, e.g. a floating tool window): the
    /// Modal dialog surface without the scrim — radius dialog, 1px border, shadow lg (`elevation`).
    /// Children are clipped to the rounded frame.
    floating { border-overlay: true; border: 1 border; corner-radius: dialog; overflow: hidden; }
    /// A message bubble (a user's turn in a chat): neutral bg-active fill, no border, radius panel;
    /// the body pads 8 12 (`Body.bubble`). No hover fill.
    bubble { background: bg-active; border-overlay: true; border: 0 transparent; corner-radius: panel; }
  }
  flag selected { background: accent-surface; border-overlay: true; border: 1 accent-border; }
  flag hoverable;
  when hoverable & !selected & kind in (default, elevated) {
    :hover { background: bg-active; }
  }
  when hoverable & !selected & kind = outlined {
    :hover { border-color: accent; }
  }
}

/// Shrink to content when size not specified; `fill` stretches the card over its container
/// (both axes, may shrink to 0 so a flexible parent decides its size).
style size($width: ?f32, $height: ?f32, $fill: bool) {
  width: $width ?? fit; height: $height ?? fit;
  when $fill { width: fill; height: fill; min-width: 0; min-height: 0; }
}

style header { align-self: stretch; direction: column; gap: 2; padding: 14 16 2 16; }
style title_row { height: 18; }
style title { color: fg-primary; font-size: md; font-weight: 600; }
style subtitle_row { height: 16; }
style subtitle { color: fg-secondary; font-size: sm; }

/// Content area: children go here; when padded = false, flush to edges.
/// Under a header the body sits closer to it: the two read as one block, with no separator.
recipe Body {
  base { width: grow; direction: column; }
  flag padded = true { padding: 14 16; }
  flag headed;
  /// The card fills its container: the content area takes the remaining height (below the header)
  /// so children sized `fill` / `grow` reach the card's bottom edge.
  flag fill { height: grow; min-height: 0; }
  /// Bubble card: compact 8 12 padding around the message.
  flag bubble;
  when padded & headed { padding: 8 16 14 16; }
  when padded & bubble { padding: space200 space300; }
}

/// Elevated cards are islands: xs contact shadow + md ambient shadow (Foundations 05). Floating
/// cards are overlays: shadow lg, like the Modal dialog panel.
pub fn elevation(kind: @import("mod.zig").CardVariant, t: *const ui.ThemeTokens) ui.BoxStyle {
    return switch (kind) {
        .elevated => .{ .shadows = ui.ShadowList.of(&.{ t.tokens.shadow.xs, t.tokens.shadow.md }) },
        .floating => .{ .shadows = ui.ShadowList.of(&.{t.tokens.shadow.lg}) },
        else => .{},
    };
}
