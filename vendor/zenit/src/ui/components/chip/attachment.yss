//! AttachmentChip styles (attachment.yix): a quiet bg-secondary row (no border, no shadow) or a
//! 44 tile on bg-tertiary; all ink from tokens.
const ui = @import("../../ui.zig");

/// Root look over ControlShell (ghost tone): fill, geometry; hover only while clickable.
recipe Attachment {
  base { background: bg-secondary; font-weight: 400; corner-radius: control; border-overlay: true; border: 0 transparent; shadow: 0 0 0 transparent; justify: start; }
  flag tile {
    width: 44; height: 44; padding: 0; gap: 0; background: bg-tertiary; overflow: hidden; justify: center;
  } else {
    height: 28; padding: 0 space100 0 space200; gap: space150; max-width: 260;
  }
  flag interactive { :hover { background: bg-active; } :active { background: button-pressed-bg; } }
}

recipe Lead {
  base { justify: center; align-items: center; corner-radius: md; overflow: hidden; }
  flag tile { width: 44; height: 44; } else { width: fit; height: fit; }
}
recipe Thumb {
  base { corner-radius: md; }
  flag tile { width: 44; height: 44; } else { width: 20; height: 20; }
}
recipe Glyph {
  flag tile { width: 16; height: 16; icon-color: fg-tertiary; } else { width: 13; height: 13; icon-color: fg-secondary; }
}

style text_row { width: fit; min-width: 0; height: fit; direction: row; align-items: baseline; gap: space150; }
style name { font-size: sm; font-weight: 400; line-height: 1.5; color: fg-primary; wrap: none; text-overflow: ellipsis; selectable: false; }
style name_box { min-width: 0; flex-shrink: 1; }
style detail { font-size: xs; line-height: 1.5; color: fg-tertiary; wrap: none; selectable: false; }
style detail_box { flex-shrink: 0; }


/// Remove button look: on the tile an 18 round over the corner, on bg-primary (readable over a
/// picture), clear of the tile's center; on the row the plain ghost xs Button.
recipe TileRemove {
  flag tile {
    width: 18; height: 18; min-height: 0; padding: 0; corner-radius: 999; justify: center; align-items: center;
    background: bg-primary;
    :hover { background: bg-active; }
  }
}
