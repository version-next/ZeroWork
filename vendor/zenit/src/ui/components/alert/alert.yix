//! Alert view. Styles in styles.yss, shared types and tests in mod.zig.
const ui = @import("../../ui.zig");
const mod = @import("mod.zig");
const S = @import("styles.yss");
const AlertVariant = mod.AlertVariant;

const icons = @import("zenit_icons");
const B = @import("../button/mod.zig");

fn detailsIcon(open: bool) ?ui.SvgAsset {
    return if (open) icons.chevron_up else icons.chevron_down;
}

fn detailsLabel(open: bool, show: []const u8, hide: []const u8) []const u8 {
    return if (open) hide else show;
}

fn statusIcon(v: AlertVariant) ui.SvgAsset {
    return switch (v) { .info => icons.info, .success => icons.circle_check, .warning => icons.triangle_alert, .@"error" => icons.circle_alert };
}

/// Announcement level: error / warning interrupts current speech (assertive), info / success
/// announces after (polite).
/// role=alert alone won't be announced; AT only auto-announces live regions when non-off.
fn liveLevel(v: AlertVariant) []const u8 {
    return switch (v) {
        .@"error", .warning => "assertive",
        .info, .success => "polite",
    };
}

/// Announcement content: announces message if present, otherwise title
fn spoken(title: []const u8, message: []const u8) ?[]const u8 {
    if (message.len > 0) return message;
    if (title.len > 0) return title;
    return null;
}

/// Static message alert (see Notifier for global alerts): info / success / warning / error, can
/// dismiss;
/// title and message can be signals; new content announced via live region.
/// W.Alert(.{ .variant = .warning, .message = status_text })
/// `actionTestId` names the action row (a `testId` on the element names only the root); null =
/// nothing written; read at mount, like every test id.
/// `actions` slot: a row of native buttons under the message (W.Button sm: retry, edit, …), 6
/// apart. `details` slot: content folded under the message (an error body, a log excerpt); a
/// ghost xs "Details" button with a chevron (after the actions) opens / closes it (`detailsOpen` is a Model:
/// bool held here, a signal two-way, ui.split parent decides; `onDetailsChange` reports).
/// `detailsTestId` names the details box, `detailsToggleTestId` the chevron button; `titleTestId` /
/// `messageTestId` name the title and message texts. `detailsText` (the toggle label) and
/// `showDetailsLabel` / `hideDetailsLabel` (its accessible names) default to English.
pub fn Alert(
    variant: AlertVariant = .info,
    title: []const u8 = "",
    message: []const u8 = "",
    closable: bool = false,
    onClose: ?Handler(void) = null,
    closeIconAsset: ?ui.SvgAsset = null,
    actionLabel: []const u8 = "",
    actionIconAsset: ?ui.SvgAsset = null,
    onAction: ?Handler(void) = null,
    actionTestId: ?[]const u8 = null,
    detailsOpen: Model(bool) = false,
    onDetailsChange: ?Handler(bool) = null,
    detailsTestId: ?[]const u8 = null,
    detailsToggleTestId: ?[]const u8 = null,
    detailsText: []const u8 = "Details",
    showDetailsLabel: []const u8 = "Show details",
    hideDetailsLabel: []const u8 = "Hide details",
    titleTestId: ?[]const u8 = null,
    messageTestId: ?[]const u8 = null,
    actions: ?View,
    details: ?View,
) View {
    const has_title = computed(title.len != 0);
    const live = computed(liveLevel(variant));
    const live_text = computed(spoken(title, message));
    return (
        <row style={S.Alert.slot(.root, .{ .kind = variant, .titled = has_title })} a11y={.{ .role = .alert, .live = live, .live_text = live_text }}>
            <box style={S.status_alignment}><icon style={S.Alert.slot(.accent, .{ .kind = variant })} src={statusIcon(variant)} /></box>
            <col style={S.content}>
                {if (has_title) <text testId={titleTestId} style={S.title}>{title}</text>}
                {if (message.len != 0) <text testId={messageTestId} style={S.message}>{message}</text>}
                {if (actionLabel.len != 0)
                    <box style={S.action_inset}>
                        <row testId={actionTestId} style={S.action_root} focusable focusRing a11y={.{ .role = .button, .label = actionLabel }} onClick={onAction}>
                            {if (actionIconAsset) |asset| <icon style={S.Action.slot(.icon, .{ .kind = variant })} src={asset} />}
                            <text style={S.Action.slot(.label, .{ .kind = variant })}>{actionLabel}</text>
                        </row>
                    </box>
                }
                {if (actions) <row style={S.actions}>{actions}</row>}
                {if (details)
                    <col style={S.details_block}>
                        <row style={S.details_toggle}>
                            <B.Button testId={detailsToggleTestId} label={detailsText} variant={.ghost} size={.xs} iconAsset={detailsIcon(detailsOpen)} iconSize={12} iconPosition={.trailing} a11yLabel={detailsLabel(detailsOpen, showDetailsLabel, hideDetailsLabel)} onClick={detailsOpen = !detailsOpen} />
                        </row>
                        <col testId={detailsTestId} style={S.details} visible={detailsOpen}>{details}</col>
                    </col>
                }
            </col>
            {if (closable)
                <row style={S.close} a11y={.{ .role = .button, .label = "Dismiss" }} onClick={onClose}>
                    {if (closeIconAsset) |asset| <icon style={S.close_icon} src={asset} /> else <icon style={S.close_icon} src={ui.assets.common.x_close} />}
                </row>
            }
        </row>
    );
}
