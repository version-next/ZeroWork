//! Kbd styles: one keycap per key in the visual language of Tag (token surfaces, `md` radius,
//! tonal tag colors) with a keycap's raised bottom edge (a 2 pt bottom border) and an equal minimum
//! width (= height), so single glyphs ("⌘", "K") are square caps and words ("Space") grow.
//! View in mod.zig; KbdSize / KbdTone are public APIs defined there.
const ui = @import("../../ui.zig");
const mod = @import("mod.zig");

style row { direction: row; width: fit; height: fit; align-items: center; no-cross-stretch: true; }

/// Keycap box: height / min width / padding by size, surface and edge by tone.
recipe KbdCap {
  base {
    direction: row; width: fit; justify: center; align-items: center;
    corner-radius: md; border-overlay: true; border-width: 1; border-bottom-width: 2;
  }
  variant size = sm {
    sm { height: 20; min-width: 20; padding: 0 space100; }
    md { height: 24; min-width: 24; padding: 0 space150; }
  }
  variant tone = neutral {
    neutral { background: bg-primary; border-color: border; }
    accent { background: accent-tag-bg; border-color: accent-tag-border; }
    warning { background: warning-tag-bg; border-color: warning-tag-border; }
    danger { background: danger-tag-bg; border-color: danger-tag-border; }
  }
}

/// Key text: font size by size, ink by tone.
recipe KbdLabel {
  base { font-weight: 500; line-height: 1.2; }
  variant size = sm {
    sm { font-size: xs; }
    md { font-size: sm; }
  }
  variant tone = neutral {
    neutral { color: fg-secondary; }
    accent { color: accent; }
    warning { color: warning; }
    danger { color: danger; }
  }
}

/// Gap between caps by size.
recipe KbdRow {
  base { }
  variant size = sm {
    sm { gap: space50; }
    md { gap: space100; }
  }
}
