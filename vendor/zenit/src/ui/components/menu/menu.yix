//! Menu rows and separators. Popover and interaction handling live in mod.zig.
const ui = @import("../../ui.zig");
const S = @import("styles.yss");
const Tag = @import("../tag/mod.zig").Tag;
const TagColor = @import("../tag/mod.zig").TagColor;

/// Divider: vertical padding, line itself 1px.
pub fn MenuSeparator() View {
    return <box style={S.separator} a11y={.{ .role = .separator }}><box style={S.separator_line} /></box>;
}

/// Group heading: a non-interactive caption that starts a group of rows (keyboard navigation,
/// typeahead and the pointer pass over it).
pub fn MenuHeader(label: []const u8) View {
    return <box style={S.header}><text style={S.header_text}>{label}</text></box>;
}

/// Pointer highlight and keyboard focus are independent. Shortcut text is only
/// a hint and becomes the item's accessibility description. `description` is a second line under
/// the label (the row grows, its content aligns to the top); `tag` a native sm Tag at the right.
pub fn MenuEntry(
    label: []const u8,
    index: usize,
    highlighted: usize,
    hovered: usize,
    keyboardFocus: bool = false,
    danger: bool = false,
    disabled: bool = false,
    shortcut: ?[]const u8 = null,
    reason: ?[]const u8 = null,
    description: ?[]const u8 = null,
    tag: ?[]const u8 = null,
    tagColor: TagColor = .neutral,
    iconAsset: ?ui.SvgAsset = null,
    tintedIcon: ?ui.SvgAsset = null,
    iconTint: ui.Color = ui.Color.TRANSPARENT,
    submenuIcon: ?ui.SvgAsset = null,
    onPick: Handler(usize),
) View {
    const lit = computed(highlighted == index or hovered == index);
    const focusVisible = computed(keyboardFocus and highlighted == index and !disabled);
    const described = computed(description != null);
    const p = parts(S.MenuRow, .{ .danger = danger, .disabled = disabled, .lit = lit, .described = described });
    return (
        <row
            style={.{ p.root, S.virtual_focus.of(.{ .visible = focusVisible }) }}
            onClick={if (!disabled) onPick(index)}
        >
            <row style={S.item_left.of(.{ .top = described })}>
                {if (iconAsset) |asset| <icon style={p.icon} src={asset} />}
                {if (tintedIcon) |asset| <icon style={S.tinted_icon} src={asset} tint={ui.view.tintBy(iconTint, S.itemTint)} />}
                {if (description) |about|
                    <col style={S.item_text}>
                        <row style={S.item_label_line}>
                            <text style={.{ S.rowText, p.label }}>{label}</text>
                            {if (reason) |why| <text style={S.reason}>{why}</text>}
                        </row>
                        <text style={.{ S.description, p.description }}>{about}</text>
                    </col>
                else
                    <row style={S.item_label_line}>
                        <text style={.{ S.rowText, p.label }}>{label}</text>
                        {if (reason) |why| <text style={S.reason}>{why}</text>}
                    </row>
                }
            </row>
            <row style={S.item_right}>
                {if (tag) |text| <Tag label={text} color={tagColor} size={.sm} />}
                {if (shortcut) |keys| <text style={S.shortcut}>{keys}</text>}
                {if (submenuIcon) |asset| <icon style={S.submenu_arrow} src={asset} />}
            </row>
        </row>
    );
}
