//! 面板头部的排版（Pencil「面板头部与空状态规范」= 浮动卡片外框头部规格：高 30 · 间距 6 · 图标 14 ·
//! 标题 12/600 · 副标题 11）。按钮是原生 ghost sm 图标按钮——这里只写布局与正文文字，不写原生组件的外观。
const ui = @import("ui");

/// 头部：`.card` 贴边（内边距 0 4 0 12，同浮动外框）；`.flush` 放在已有内边距的容器里（左右不再留白）。
recipe Header {
  base { width: fill; min-width: 0; height: 30; flex-shrink: 0; direction: row; align-items: center; gap: 6; }
  variant inset = card {
    card { padding: 0 4 0 12; }
    flush { padding: 0; }
  }
}
pub const Inset = Header.Dim(.inset);
recipe Icon {
  base { width: 14; height: 14; flex-shrink: 0; }
  flag accent { icon-color: accent; } else { icon-color: fg-secondary; }
}
/// 标题最后让位：副标题先省略号截断，标题以几乎为零的收缩权重截断，按钮永不收缩。
style title_box { width: fit; min-width: 0; flex-shrink: 0.01; direction: row; align-items: center; overflow: hidden; }
style title { font-size: 12; font-weight: 600; color: fg-primary; wrap: none; text-overflow: ellipsis; selectable: false; }
style subtitle_box { width: fit; max-width: 200; min-width: 0; flex-shrink: 1; direction: row; align-items: center; overflow: hidden; }
style subtitle { font-size: 11; color: fg-secondary; wrap: none; text-overflow: ellipsis; selectable: false; }
style text_box { width: fill; min-width: 0; }
style spacer { width: grow; min-width: 0; height: 1; }
/// 动作区：辅助动作（原生组件），间距同头部；永不收缩。
style actions { width: fit; height: fit; flex-shrink: 0; direction: row; align-items: center; gap: 6; }
/// 关闭按钮的槽：原生 ghost sm 图标按钮 24 × 24，永不收缩。
style action { width: fit; height: fit; flex-shrink: 0; }
