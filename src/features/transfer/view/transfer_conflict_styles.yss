//! 同名文件处理对话框（`transfer_conflict.yix`）的布局与正文文字。
//!
//! 对话框面板、遮罩、单选组、输入框、复选框、按钮、提示条、滚动条都是 zenit 原生组件的默认外观；这里只写调用方
//! 自己的盒子（头部一行、正文滚动区的几何、对比卡片、页脚一行）和正文文字，颜色全部是 token。
const ui = @import("ui");

/// 对话框宽度上限；窄窗口里两侧各留 8。
pub const dialog_width: f32 = 480;
pub const window_gutter: f32 = 16;
/// 头部 52 + 页脚 64：正文滚动区之外固定占掉的高度。
pub const chrome_height: f32 = 116;

/// Modal 正文槽里的一列：头部、正文滚动区、页脚。高度随内容，由 Modal 的 maxHeight 封顶。
style form { width: fill; height: fit; min-height: 0; flex-shrink: 1; direction: column; gap: 0; }
style header { width: fill; height: 52; flex-shrink: 0; direction: row; align-items: center; gap: 8; padding: 12 16 0 20; }
style header_icon { width: 18; height: 18; flex-shrink: 0; icon-color: accent; }
style title { font-size: 15; font-weight: 600; line-height: {22.0 / 15.0}; color: fg-primary; wrap: none; text-overflow: ellipsis; selectable: false; }
style title_box { width: fill; flex: 1; min-width: 0; }
/// 正文滚动区（原生 ScrollArea 的根）：只给几何——宽度、随内容的高度及其上限、左右留白。
style viewport($max: f32) { width: fill; height: {.{ .fit = .{ .max = $max } }}; min-height: 0; flex-shrink: 1; margin: 0 20; }
/// 滚动内容：一列，间距 8。
style body { width: fill; height: fit; direction: column; gap: 8; min-width: 0; }
style stack { width: fill; height: fit; direction: column; gap: 8; min-width: 0; flex-shrink: 0; }
style confirmation { width: fill; height: fit; direction: column; gap: 10; min-width: 0; flex-shrink: 0; }
/// 原生控件外面的定位盒：占满一行，高度随控件。
style field { width: fill; height: fit; flex-shrink: 0; direction: column; }
style footer { width: fill; height: 64; flex-shrink: 0; direction: row; align-items: center; justify: end; gap: 8; padding: 12 20 20 20; }
style spacer { width: grow; min-width: 0; height: 1; }

style text_box { width: fill; height: fit; min-width: 0; flex-shrink: 0; }
style caption { font-size: 12.5; font-weight: 500; line-height: {18.0 / 12.5}; color: fg-primary; wrap: word; selectable: false; }
style path { font-size: 10.5; font-weight: 400; line-height: {17.0 / 10.5}; color: fg-primary; wrap: char; use-monospace-font: true; selectable: true; }
style detail { font-size: 10.5; font-weight: 400; line-height: {17.0 / 10.5}; color: fg-secondary; wrap: word; selectable: false; }
style metadata { font-size: 11.5; font-weight: 400; line-height: {18.0 / 11.5}; color: fg-secondary; wrap: word; selectable: false; }
style issue { font-size: 10.5; font-weight: 400; line-height: {17.0 / 10.5}; color: danger; wrap: word; selectable: false; }

/// 对比卡片：两张并排，间距 10。
style compare { width: fill; height: fit; direction: row; gap: 10; min-width: 0; flex-shrink: 0; }
style compare_card { width: fill; flex: 1; height: fit; min-width: 0; direction: column; gap: 6; padding: 10; background: zw-island-rest; corner-radius: 8; overflow: hidden; }
style compare_head { width: fill; height: fit; direction: row; align-items: center; gap: 8; min-width: 0; }
style compare_icon { width: 24; height: 24; flex-shrink: 0; icon-color: fg-secondary; }
style compare_titles { width: fill; flex: 1; min-width: 0; direction: column; gap: 1; }
style compare_title { font-size: 12.5; font-weight: 600; line-height: {16.0 / 12.5}; color: fg-primary; wrap: none; text-overflow: ellipsis; selectable: false; }
style compare_place { font-size: 10.5; font-weight: 400; line-height: {14.0 / 10.5}; color: fg-secondary; wrap: none; text-overflow: ellipsis; selectable: false; }
style compare_meta { width: fill; height: fit; direction: column; min-width: 0; }
style compare_row { width: fill; height: 20; direction: row; align-items: center; gap: 8; min-width: 0; }
style compare_key { font-size: 12; font-weight: 400; line-height: {16.0 / 12.0}; color: fg-secondary; wrap: none; selectable: false; }
style compare_key_box { flex-shrink: 0; }
style compare_value { font-size: 12; font-weight: 400; line-height: {16.0 / 12.0}; color: fg-primary; wrap: none; text-overflow: ellipsis; text-align: end; selectable: false; }
style compare_value_box { width: fill; flex: 1; min-width: 0; overflow: hidden; }

style anchor { position: absolute; width: 0; height: 0; }
