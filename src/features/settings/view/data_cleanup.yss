//! “清除全部数据…”确认对话框（S-12，`data_cleanup.yix`）的正文样式。面板、遮罩、标题栏、按钮都是原生 `W.Modal` /
//! `W.Button` 默认外观；这里只给正文的布局盒子与文字（颜色只用 token）。文字层级同 H-save 的确认对话框（`styles.yss` 的
//! `confirm_*`）：说明 13 / 提示 12，警示句用 `danger`。
const ui = @import("ui");

/// 插槽正文：范围说明、保留说明、后果、状态行（标题句是确认框的说明）。
style detail { font-size: 13; font-weight: 400; line-height: 1.5; color: fg-primary; wrap: word; }
style outcome { font-size: 12; font-weight: 400; line-height: 1.5; color: zw-fg-supporting; wrap: word; }
/// 状态行（阻塞原因 / 进行中说明 / 失败原因）：空时不占高。
recipe Message {
  base { font-size: 12; font-weight: 400; line-height: 1.5; color: zw-fg-supporting; wrap: word; }
  flag warning { color: danger; }
}
style text_box { width: fill; }
