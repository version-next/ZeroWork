//! “数据与日志 › 清除全部数据…”的确认对话框（S-12）：共享的原生确认框 `W.ConfirmDialog`（默认遮罩、面板、标题栏与按钮），
//! 内容控件全部原生、无覆盖。开合、文案与可用性来自 view-model（`ViewModel.cleanup*`，状态机在 `model/data_cleanup.zig`）；
//! 宿主只执行副作用（打开前检查、复查阻塞、清除、失败回报、回焦），经 `Effect.data_cleanup` / `Intent.cleanup` 往返。
//!
//! - 打开时焦点在“取消”；进入失败态时焦点回到“退出应用”（`refocus` 跟着流程阶段）。
//! - 遮罩点击不关；Escape / 标题栏关闭按“取消”处理，清除进行中不接（`cancelDisabled`）。
//! - test_id：`data.cleanup.modal`（面板）、`.headline`（标题句）、`.message`、`.cancel`、`.confirm`（旧的 `.title.icon` 已删）。
const ui = @import("ui");
const W = ui.widgets;
const m = @import("../model/view_model.zig");
const S = @import("styles.yss");
const D = @import("data_cleanup.yss");
const C = m.data_cleanup;

fn send(vm: *m.ViewModel, intent: m.Intent) void {
    vm.dispatch(intent);
}
fn phaseRevision(vm: *m.ViewModel) u64 {
    return vm.cleanupPhase()[0];
}

/// 外层 box 只是挂载点（原生对话框挂到窗口浮层根上）；只在流程打开时挂载（同 `save_bar.Confirmation`）。
/// 共享的原生确认框（`shared/ui/confirm`，`W.ConfirmDialog`）：标题、标题句（说明）、范围 / 保留 / 后果 / 状态行（插槽）、
/// “取消 / 退出应用”与危险的“清除全部数据 / 重试清除”。清除进行中取消不可用（Escape、标题栏关闭也不接）；换阶段时焦点回到
/// “取消 / 退出应用”（`refocus`）。点遮罩不关（清除流程有进行中与失败态，避免误触丢失失败说明）。
pub fn DataCleanup(vm: *m.ViewModel) View {
    return (
        <box style={S.confirm_anchor}>
        {if (vm.cleanupOpen())
        <W.ConfirmDialog open={vm.cleanupOpen()} onCancel={send(vm, m.Intent.cancelCleanup())} onConfirm={send(vm, m.Intent.confirmCleanup())} closeOnConfirm={false} closeOnOverlay={false} title={vm.cleanupTitle()} message={vm.cleanupHeadline()} confirmLabel={vm.cleanupPrimaryLabel()} cancelLabel={vm.cleanupCancelLabel()} confirmDisabled={vm.cleanupPrimaryDisabled()} confirmLoading={vm.cleanupPrimaryBusy()} confirmShown={vm.cleanupPrimaryShown()} cancelDisabled={vm.cleanupCancelDisabled()} refocus={phaseRevision(vm)} width={520} animateInitialOpen={true} testIds={.{ .dialog = "data.cleanup.modal", .message = "data.cleanup.headline", .cancel = "data.cleanup.cancel", .confirm = "data.cleanup.confirm" }}>
            <text style={D.detail} box={D.text_box}>{C.scope_text}</text>
            <text style={D.detail} box={D.text_box}>{C.preserved_text}</text>
            <text style={D.outcome} box={D.text_box}>{C.outcome_text}</text>
            <text testId="data.cleanup.message" a11y={.{ .role = .status, .live = "polite" }} style={D.Message.of(.{ .warning = vm.cleanupMessageWarning() })} box={D.text_box}>{vm.cleanupMessage()}</text>
        </W.ConfirmDialog>
        }
        </box>
    );
}
